# Build output
bin/
obj/
*.user
*.suo
.vs/
.packages/

# The ARM32 CPython core and the host DLL are build products of
# scripts\build-pythoncore.ps1 and scripts\build-pythonhost.ps1. They are large
# and reproducible, so they are not tracked.
native/build-arm/
native/out/
native/*.log

# The desktop smoke test's staged runtime root and build output. Regenerated by
# scripts\test-pythonhost-desktop.ps1 on every run (and the staged Lib tree is a
# copy of an external source tree, so it must never be committed).
native/desktop-stage/
native/desktop-build/
native/desktop-smoke.log

# appx output. The ARM appx is a deliverable, but it is regenerated by
# scripts\build-app.ps1 and the source tree is the source of truth.
app/DesultorySignals/AppPackages/
app/DesultorySignals/bin/
app/DesultorySignals/obj/
app/DesultorySignals/Generated Files/
app/build-app.log

# The staged native runtime: copied in by scripts\build-app.ps1.
app/DesultorySignals/libs/ARM/*.dll

# Python bytecode
__pycache__/
*.pyc

# Research scratch: the capture and evidence directories are tracked (they are the
# proof), but intermediate solver output is not.
_research/abogus/capture/*.tmp

# Release synchronization: generated files and local credentials
.vs/
.idea/
.claude/
.agents/
.reasonix/
.superdesign/
.zcode/
