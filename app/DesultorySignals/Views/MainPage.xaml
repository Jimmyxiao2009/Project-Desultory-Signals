<Page
    x:Class="DesultorySignals.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <ScrollViewer>
            <StackPanel Margin="12">

                <!-- runtime / session status -->
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" FontSize="14"
                           Text="正在启动..." Margin="0,0,0,4" />
                <TextBlock x:Name="SessionText" TextWrapping="Wrap" FontSize="14"
                           Margin="0,0,0,4" />
                <TextBlock x:Name="ActionText" TextWrapping="Wrap" FontSize="14"
                           Foreground="Orange" Margin="0,0,0,10" />

                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <Button Content="扫码登录" Click="OnQrLoginClick" Margin="0,0,6,0" />
                    <Button Content="取消" Click="OnStopClick" />
                </StackPanel>
                <TextBlock x:Name="LoginText" TextWrapping="Wrap" FontSize="14" Margin="0,4,0,4" />
                <Image x:Name="QrImage" Height="240" HorizontalAlignment="Center" />

                <!-- open one aweme -->
                <TextBlock Text="aweme_id 或分享链接" Margin="0,0,0,2" />
                <TextBox x:Name="IdBox" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,10">
                    <Button Content="打开" Click="OnOpenClick" Margin="0,0,6,0" />
                </StackPanel>

                <!-- feed -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <Button Content="加载 Feed" Click="OnLoadFeedClick" Margin="0,0,6,0" />
                    <Button Content="下一页" Click="OnNextPageClick" Margin="0,0,6,0" />
                    <Button Content="刷新" Click="OnRefreshFeedClick" Margin="0,0,6,0" />
                </StackPanel>
                <TextBlock x:Name="FeedText" TextWrapping="Wrap" FontSize="14" Margin="0,0,0,4" />
                <ListView x:Name="FeedList" Height="260" SelectionMode="Single"
                          SelectionChanged="OnFeedSelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- search and author profile -->
                <TextBlock Text="搜索" Margin="0,12,0,4" />
                <TextBox x:Name="SearchBox" PlaceholderText="视频或用户关键词" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                    <Button Content="搜视频" Click="OnSearchVideosClick" Margin="0,0,6,0" />
                    <Button Content="搜用户" Click="OnSearchUsersClick" Margin="0,0,6,0" />
                    <Button Content="更多结果" Click="OnMoreSearchClick" />
                </StackPanel>
                <TextBlock x:Name="SearchText" TextWrapping="Wrap" />
                <ListView x:Name="SearchVideos" Height="180" SelectionChanged="OnFeedSelectionChanged">
                    <ListView.ItemTemplate><DataTemplate><TextBlock Text="{Binding Summary}" TextWrapping="Wrap" /></DataTemplate></ListView.ItemTemplate>
                </ListView>
                <ListView x:Name="SearchUsers" Height="160" SelectionChanged="OnUserSelectionChanged">
                    <ListView.ItemTemplate><DataTemplate><TextBlock Text="{Binding Summary}" TextWrapping="Wrap" /></DataTemplate></ListView.ItemTemplate>
                </ListView>
                <TextBlock Text="作者主页" Margin="0,8,0,4" />
                <TextBox x:Name="ProfileBox" PlaceholderText="作者主页链接或 sec_uid" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                    <Button Content="打开主页" Click="OnOpenProfileClick" Margin="0,0,6,0" />
                    <Button Content="当前作者" Click="OnCurrentAuthorClick" Margin="0,0,6,0" />
                    <Button Content="更多作品" Click="OnMorePostsClick" />
                </StackPanel>
                <TextBlock x:Name="ProfileText" TextWrapping="Wrap" />
                <ListView x:Name="ProfileVideos" Height="200" SelectionChanged="OnFeedSelectionChanged">
                    <ListView.ItemTemplate><DataTemplate><TextBlock Text="{Binding Summary}" TextWrapping="Wrap" /></DataTemplate></ListView.ItemTemplate>
                </ListView>

                <!-- playback -->
                <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
                    <Button Content="播放（下载）" Click="OnPlayDownloadClick" Margin="0,0,6,0" />
                    <Button Content="播放（流式）" Click="OnPlayStreamClick" Margin="0,0,6,0" />
                </StackPanel>
                <Button Content="停止" Click="OnStopClick" Margin="0,0,0,4" />
                <MediaElement x:Name="MediaSurface" Height="240"
                              AreTransportControlsEnabled="True" />

                <!-- comments -->
                <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
                    <Button Content="评论" Click="OnLoadCommentsClick" Margin="0,0,6,0" />
                    <Button Content="更多评论" Click="OnMoreCommentsClick" Margin="0,0,6,0" />
                </StackPanel>
                <ListView x:Name="CommentList" Height="200" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel Margin="0,4,0,10">
                    <TextBox x:Name="CommentBox" PlaceholderText="评论内容" Margin="0,0,6,0" />
                    <Button Content="发表评论" Click="OnPublishCommentClick" />
                </StackPanel>

                <!-- session -->
                <TextBlock Text="也可导入已登录浏览器的 Cookie" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <Button Content="导入 Cookie" Click="OnImportCookieClick" Margin="0,0,6,0" />
                    <Button Content="登出" Click="OnLogoutClick" Margin="0,0,6,0" />
                    <Button Content="检查会话" Click="OnCheckSessionClick" Margin="0,0,6,0" />
                </StackPanel>
                <TextBox x:Name="CookieBox" AcceptsReturn="True" Height="70"
                         PlaceholderText="粘贴完整 Cookie 头（name=value; name=value）" />


                <!-- diagnostics -->
                <StackPanel Orientation="Horizontal" Margin="0,12,0,20">
                    <Button Content="诊断" Click="OnDiagnosticsClick" Margin="0,0,6,0" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
